{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "@phase2-api-url",
    "NEXT_PUBLIC_CHATBOT_API_URL": "@phase3-chatbot-url",
    "NEXT_PUBLIC_AUTH_URL": "@phase2-api-url",
    "NEXT_PUBLIC_CHATKIT_BACKEND_URL": "@phase3-chatbot-url",
    "NEXT_PUBLIC_OPENAI_DOMAIN_KEY": "@openai-domain-key",
    "NEXT_PUBLIC_ENABLE_CHATBOT": "true"
  }
}
